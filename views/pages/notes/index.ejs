<%
  const saleEventSection = saleEventManagement || {};
  const saleEvents = saleEventSection.events || [];
  const eventPagination = saleEventSection.pagination || {};
  const editingEvent = saleEventSection.editingEvent || null;
  const buildPageUrl = (page) => {
    const params = new URLSearchParams();
    if (filters.keyword) params.set("keyword", filters.keyword);
    if (filters.categoryId) params.set("categoryId", filters.categoryId);
    params.set("page", page);
    return `/notes?${params.toString()}`;
  };
  const buildEventPageUrl = (page) => `/notes?tab=events&eventPage=${page}`;
  const buildEventEditUrl = (eventId) => `/notes?tab=events&eventPage=${eventPagination.page || 1}&eventEdit=${eventId}`;
%>
<section class="min-w-0 space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h1 class="text-3xl font-black text-slate-900">Ghi chú</h1><p class="mt-1 text-slate-500">Theo dõi các ghi chú cho cửa hàng, nhân viên và đồ thuê.</p></div><% if (currentUser.role === "admin" && activeTab === "notes") { %><a href="/notes/new" class="inline-flex rounded-full bg-brand-500 px-5 py-3 font-semibold text-white transition hover:bg-brand-700">Thêm ghi chú</a><% } %></div>
  <div class="inline-flex rounded-full bg-white p-1 shadow-lg shadow-slate-200/60"><a href="/notes" class="rounded-full px-5 py-3 text-sm font-semibold <%= activeTab === 'notes' ? 'bg-slate-900 text-white' : 'text-slate-600' %>">Ghi chú</a><% if (currentUser.role === "admin") { %><a href="/notes?tab=events" class="rounded-full px-5 py-3 text-sm font-semibold <%= activeTab === 'events' ? 'bg-slate-900 text-white' : 'text-slate-600' %>">Sự kiện sale</a><% } %></div>
  <% if (activeTab === "notes") { %>
  <form action="/notes" method="GET" class="grid gap-4 rounded-3xl bg-white p-5 shadow-lg shadow-slate-200/60 md:grid-cols-[1fr_16rem_auto]"><input name="keyword" value="<%= filters.keyword %>" placeholder="Tìm kiếm theo tiêu đề hoặc nội dung" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" /><select name="categoryId" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"><option value="">Tất cả danh mục</option><% categories.forEach((category) => { %><option value="<%= category._id %>" <%= filters.categoryId === category._id.toString() ? "selected" : "" %>><%= category.categoryCode %> - <%= category.displayName %></option><% }) %></select><button type="submit" class="rounded-full bg-slate-900 px-6 py-3 font-semibold text-white">Tìm kiếm</button></form>
  <div class="min-w-0 overflow-hidden rounded-3xl bg-white shadow-lg shadow-slate-200/60"><div class="table-scroll"><table class="min-w-full divide-y divide-slate-200"><thead class="bg-slate-50"><tr><th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Tiêu đề</th><th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Nội dung</th><th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Danh mục</th><th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Thao tác</th></tr></thead><tbody class="divide-y divide-slate-100"><% if (notes.length === 0) { %><tr><td colspan="4" class="px-6 py-10 text-center text-slate-500">Không có dữ liệu.</td></tr><% } %><% notes.forEach((note) => { %><tr><td class="px-6 py-4 font-semibold text-slate-900"><%= note.title %></td><td class="table-cell-wrap px-6 py-4 text-slate-600"><%= note.description %></td><td class="px-6 py-4 text-slate-600"><%= note.categoryId?.categoryCode %> - <%= note.categoryId?.displayName %></td><td class="px-6 py-4"><div class="flex justify-end gap-2"><% if (currentUser.role === "admin") { %><a href="/notes/<%= note._id %>/edit" class="rounded-full bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-800">Chỉnh sửa</a><form action="/notes/<%= note._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Xóa ghi chú này?');"><button type="submit" class="rounded-full bg-rose-100 px-4 py-2 text-sm font-semibold text-rose-800">Xóa</button></form><% } %></div></td></tr><% }) %></tbody></table></div></div>
  <div class="flex flex-col gap-3 rounded-3xl bg-white px-6 py-4 text-sm text-slate-600 shadow-lg shadow-slate-200/60 sm:flex-row sm:items-center sm:justify-between"><span>Trang <%= pagination.page %>/<%= pagination.totalPages %> · Tổng <%= pagination.totalItems %> ghi chú</span><div class="flex gap-2"><% if (pagination.hasPrev) { %><a href="<%= buildPageUrl(pagination.prevPage) %>" class="rounded-full bg-slate-100 px-4 py-2 font-semibold text-slate-700">Trang trước</a><% } %><% if (pagination.hasNext) { %><a href="<%= buildPageUrl(pagination.nextPage) %>" class="rounded-full bg-brand-50 px-4 py-2 font-semibold text-brand-700">Trang sau</a><% } %></div></div>
  <% } %>
  <% if (activeTab === "events" && currentUser.role === "admin") { %>
    <div class="rounded-[2rem] bg-brand-50 p-6 text-slate-700">
      <h2 class="text-xl font-black text-slate-900">Sự kiện sale</h2>
      <p class="mt-2 text-sm">Chỉ sự kiện có trạng thái đang hoạt động mới hiển thị trên trang Tổng quan cho toàn bộ tài khoản.</p>
    </div>
    <div class="grid gap-6 xl:grid-cols-[0.95fr_1.05fr]">
      <form action="<%= editingEvent ? `/notes/events/${editingEvent._id}?tab=events&eventPage=${eventPagination.page || 1}&_method=PUT` : `/notes/events?tab=events&eventPage=${eventPagination.page || 1}` %>" method="POST" class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
        <h2 class="text-2xl font-black text-slate-900"><%= editingEvent ? "Cập nhật sự kiện sale" : "Tạo sự kiện sale" %></h2>
        <div class="mt-6 space-y-5">
          <div><label class="mb-2 block text-sm font-semibold text-slate-700">Tiêu đề</label><input name="title" required value="<%= editingEvent?.title || '' %>" placeholder="Ví dụ: Giảm giá Quốc khánh" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" /></div>
          <div><label class="mb-2 block text-sm font-semibold text-slate-700">Mô tả</label><textarea name="description" rows="5" required placeholder="Nhập nội dung sự kiện sale" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"><%= editingEvent?.description || '' %></textarea></div>
          <div><label class="mb-2 block text-sm font-semibold text-slate-700">Trạng thái</label><select name="status" required class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"><option value="active" <%= !editingEvent || editingEvent.status === "active" ? "selected" : "" %>>Đang hoạt động</option><option value="inactive" <%= editingEvent?.status === "inactive" ? "selected" : "" %>>Tạm dừng</option></select></div>
          <div class="flex gap-3"><button type="submit" class="rounded-full bg-brand-500 px-6 py-3 font-semibold text-white transition hover:bg-brand-700"><%= editingEvent ? "Cập nhật" : "Thêm sự kiện" %></button><% if (editingEvent) { %><a href="<%= buildEventPageUrl(eventPagination.page || 1) %>" class="rounded-full bg-slate-100 px-6 py-3 font-semibold text-slate-700">Hủy</a><% } %></div>
        </div>
      </form>
      <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60"><h2 class="text-2xl font-black text-slate-900">Hiển thị trên trang Tổng quan</h2><p class="mt-4 text-slate-600">Đặt trạng thái thành <span class="font-semibold text-emerald-700">Đang hoạt động</span> để nhân viên và quản trị viên đều nhìn thấy sự kiện bên cạnh lời chào trên trang Tổng quan.</p></div>
    </div>
    <div class="overflow-hidden rounded-3xl bg-white shadow-lg shadow-slate-200/60">
      <div class="table-scroll"><table class="min-w-full divide-y divide-slate-200"><thead class="bg-slate-50"><tr><th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Tiêu đề</th><th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Mô tả</th><th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Trạng thái</th><th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Thao tác</th></tr></thead><tbody class="divide-y divide-slate-100"><% if (saleEvents.length === 0) { %><tr><td colspan="4" class="px-6 py-10 text-center text-slate-500">Chưa có sự kiện sale nào.</td></tr><% } %><% saleEvents.forEach((event) => { %><tr><td class="px-6 py-4 font-semibold text-slate-900"><%= event.title %></td><td class="table-cell-wrap px-6 py-4 text-slate-600"><%= event.description %></td><td class="px-6 py-4"><span class="rounded-full px-3 py-1 text-sm font-semibold <%= event.status === 'active' ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700' %>"><%= event.status === "active" ? "Đang hoạt động" : "Tạm dừng" %></span></td><td class="px-6 py-4"><div class="flex justify-end gap-2"><a href="<%= buildEventEditUrl(event._id) %>" class="rounded-full bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-800">Chỉnh sửa</a><form action="/notes/events/<%= event._id %>?tab=events&eventPage=<%= eventPagination.page || 1 %>&_method=DELETE" method="POST" onsubmit="return confirm('Xóa sự kiện sale này?');"><button type="submit" class="rounded-full bg-rose-100 px-4 py-2 text-sm font-semibold text-rose-800">Xóa</button></form></div></td></tr><% }) %></tbody></table></div>
      <div class="flex flex-col gap-3 border-t border-slate-200 px-6 py-4 text-sm text-slate-600 sm:flex-row sm:items-center sm:justify-between"><span>Trang <%= eventPagination.page %>/<%= eventPagination.totalPages %> · Tổng <%= eventPagination.totalItems %> sự kiện sale</span><div class="flex gap-2"><% if (eventPagination.hasPrev) { %><a href="<%= buildEventPageUrl(eventPagination.prevPage) %>" class="rounded-full bg-slate-100 px-4 py-2 font-semibold text-slate-700">Trang trước</a><% } %><% if (eventPagination.hasNext) { %><a href="<%= buildEventPageUrl(eventPagination.nextPage) %>" class="rounded-full bg-brand-50 px-4 py-2 font-semibold text-brand-700">Trang sau</a><% } %></div></div>
    </div>
  <% } %>
</section>
