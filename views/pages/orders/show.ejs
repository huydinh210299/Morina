<%
  const totalPaid = order.payments.reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
  const totalDue = Number(order.orderAmount || 0) + Number(order.surcharge || 0) + Number(order.deposit || 0);
  const remainingAmount = totalDue - totalPaid;
  const isOverpaid = remainingAmount < 0;
%>

<section class="space-y-6">
  <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-700">Chi tiết đơn hàng</p>
        <h1 class="mt-3 text-3xl font-black text-slate-900"><%= order.customerName %> · <%= order.phone %></h1>
      </div>
      <div class="flex gap-3">
        <% if (currentUser.role === "admin") { %>
          <a href="/orders/<%= order._id %>/edit" class="rounded-full bg-amber-100 px-5 py-3 font-semibold text-amber-800">Sửa</a>
        <% } %>
        <a href="/orders" class="rounded-full bg-slate-100 px-5 py-3 font-semibold text-slate-700">Quay lại</a>
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl bg-slate-50 p-5">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Lịch thuê</p>
        <p class="mt-3 text-slate-700">Bắt đầu: <%= new Date(order.generalStartTime).toLocaleString() %></p>
        <p class="mt-2 text-slate-700">Kết thúc: <%= new Date(order.generalEndTime).toLocaleString() %></p>
      </div>
      <div class="rounded-3xl bg-slate-50 p-5">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Tài chính</p>
        <p class="mt-3 text-slate-700">Tổng tiền đơn: <%= formatCurrency(order.orderAmount) %></p>
        <p class="mt-2 text-slate-700">Tiền cọc: <%= formatCurrency(order.deposit) %></p>
        <form action="/orders/<%= order._id %>/deposit?_method=PUT" method="POST" class="mt-3 flex flex-col gap-3 sm:flex-row">
          <label class="sr-only" for="deposit-<%= order._id %>">Tiền cọc mới</label>
          <input id="deposit-<%= order._id %>" name="deposit" type="number" min="<%= Number(order.deposit) %>" step="1" data-greater-than-current-message="Tiền cọc mới không được nhỏ hơn tiền cọc hiện tại." required placeholder="Nhập tiền cọc mới" class="min-w-0 flex-1 rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
          <button type="submit" class="rounded-full bg-amber-100 px-5 py-3 font-semibold text-amber-800 transition hover:bg-amber-200">Cập nhật cọc</button>
        </form>
        <p class="mt-2 text-slate-700">Phụ thu: <%= formatCurrency(order.surcharge) %></p>
        <p class="mt-2 text-slate-700">Tổng cần thu (đơn + phụ thu + cọc): <span class="font-semibold"><%= formatCurrency(totalDue) %></span></p>
        <p class="mt-2 text-slate-700">Đã thanh toán: <span class="font-semibold"><%= formatCurrency(totalPaid) %></span></p>
        <p class="mt-2 text-slate-700">
          <%= isOverpaid ? "Thanh toán dư" : "Còn cần thanh toán" %>:
          <span class="font-semibold <%= isOverpaid ? 'text-emerald-700' : 'text-rose-700' %>"><%= formatCurrency(Math.abs(remainingAmount)) %></span>
        </p>
      </div>
    </div>

    <form action="/orders/<%= order._id %>/note" method="POST" class="mt-6 rounded-3xl border border-slate-200 bg-slate-50 p-5">
      <label class="mb-2 block text-sm font-semibold text-slate-700">Ghi chú đơn hàng</label>
      <textarea name="note" rows="4" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100"><%= order.note || '' %></textarea>
      <button type="submit" class="mt-3 rounded-full bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-slate-700">Cập nhật ghi chú</button>
    </form>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl font-black text-slate-900">Sản phẩm</h2>
        <button type="button" data-add-order-product-open class="rounded-full bg-brand-50 px-4 py-2 text-sm font-semibold text-brand-700 transition hover:bg-brand-100">Thêm sản phẩm</button>
      </div>
      <div class="mt-5 space-y-4">
        <% if (order.products.length === 0) { %>
          <p class="text-slate-500">Chưa có dòng sản phẩm.</p>
        <% } %>
        <% order.products.forEach((item) => { %>
          <div class="rounded-3xl border border-slate-200 p-4">
            <p class="font-semibold text-slate-900"><%= item.product?.code || "Sản phẩm không xác định" %></p>
            <p class="mt-2 text-sm text-slate-600"><%= formatCurrency(item.price) %></p>
            <p class="mt-1 text-sm text-slate-500"><%= new Date(item.startTime).toLocaleString() %> → <%= new Date(item.endTime).toLocaleString() %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-2xl font-black text-slate-900">Phụ kiện</h2>
        <button type="button" data-add-order-accessory-open class="rounded-full bg-brand-50 px-4 py-2 text-sm font-semibold text-brand-700 transition hover:bg-brand-100">Thêm phụ kiện</button>
      </div>
      <div class="mt-5 space-y-4">
        <% if (order.accessories.length === 0) { %>
          <p class="text-slate-500">Chưa có dòng phụ kiện.</p>
        <% } %>
        <% order.accessories.forEach((item) => { %>
          <div class="rounded-3xl border border-slate-200 p-4">
            <p class="font-semibold text-slate-900"><%= item.accessory?.code || "Phụ kiện không xác định" %> <%= item.accessory?.name ? `- ${item.accessory.name}` : "" %></p>
            <p class="mt-2 text-sm text-slate-600">Số lượng thuê: <%= item.amount ?? 1 %></p>
            <p class="mt-2 text-sm text-slate-600"><%= formatCurrency(item.price) %></p>
            <p class="mt-1 text-sm text-slate-500"><%= new Date(item.startTime).toLocaleString() %> → <%= new Date(item.endTime).toLocaleString() %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <dialog data-add-order-product-modal class="w-full max-w-xl rounded-3xl border-0 bg-transparent p-0 backdrop:bg-slate-950/70">
    <form action="/orders/<%= order._id %>/products" method="POST" data-add-order-product-form data-current-order-amount="<%= Number(order.orderAmount) %>" class="max-h-[90vh] overflow-y-auto rounded-3xl bg-white p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-2xl font-black text-slate-900">Thêm sản phẩm vào đơn hàng</h2>
          <p class="mt-1 text-sm text-slate-500">Tổng tiền mới phải lớn hơn tổng tiền đơn hiện tại.</p>
        </div>
        <button type="button" data-add-order-product-close aria-label="Đóng" class="inline-flex size-10 items-center justify-center rounded-full bg-slate-100 text-2xl leading-none text-slate-600 transition hover:bg-slate-200">&times;</button>
      </div>

      <div id="add-order-products-container" class="mt-6 space-y-4"></div>
      <button type="button" data-add-order-product-row class="mt-4 rounded-full bg-brand-50 px-4 py-2 text-sm font-semibold text-brand-700 transition hover:bg-brand-100">Thêm dòng sản phẩm</button>

      <datalist id="available-order-products">
        <% availableProducts.forEach((product) => { %>
          <option value="<%= product.code %>" data-full-day-price="<%= product.fullDayPrice %>"><%= [product.code, product.size, product.note].filter(Boolean).join(" - ") %></option>
        <% }) %>
      </datalist>

      <label class="mt-4 block">
        <span class="mb-2 block text-sm font-semibold text-slate-700">Tổng tiền đơn mới</span>
        <input name="orderAmount" type="number" min="<%= Number(order.orderAmount) %>" step="1" data-add-order-product-total data-greater-than-current-message="Tổng tiền đơn mới không được nhỏ hơn tổng tiền đơn hiện tại." required placeholder="Tự động tính sau khi chọn sản phẩm" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
        <p class="mt-2 text-sm text-slate-500">Tổng tiền hiện tại: <%= formatCurrency(order.orderAmount) %></p>
      </label>

      <div class="mt-6 flex justify-end gap-3">
        <button type="button" data-add-order-product-close class="rounded-full bg-slate-100 px-5 py-3 font-semibold text-slate-700 transition hover:bg-slate-200">Hủy</button>
        <button type="submit" class="rounded-full bg-brand-500 px-5 py-3 font-semibold text-white transition hover:bg-brand-700">Thêm sản phẩm</button>
      </div>
    </form>
  </dialog>

  <template id="add-order-product-row-template">
    <div data-add-order-product-entry class="rounded-3xl border border-slate-200 bg-slate-50 p-4">
      <div class="flex items-center justify-between gap-3">
        <p class="font-semibold text-slate-700">Sản phẩm bổ sung</p>
        <button type="button" data-remove-order-product-row class="rounded-full bg-rose-50 px-3 py-1.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">Xóa</button>
      </div>
      <label class="mt-4 block">
        <span class="mb-2 block text-sm font-semibold text-slate-700">Sản phẩm</span>
        <input name="productCodes" type="text" list="available-order-products" data-add-order-product-code required autocomplete="off" placeholder="Tìm kiếm hoặc chọn sản phẩm" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
      </label>
      <label class="mt-4 block">
        <span class="mb-2 block text-sm font-semibold text-slate-700">Giá sản phẩm</span>
        <input name="productPrices" type="number" min="0" step="0.01" data-add-order-product-price required placeholder="Nhập giá sản phẩm" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
      </label>
    </div>
  </template>

  <dialog data-add-order-accessory-modal class="w-full max-w-xl rounded-3xl border-0 bg-transparent p-0 backdrop:bg-slate-950/70">
    <form action="/orders/<%= order._id %>/accessories" method="POST" data-add-order-accessory-form data-current-order-amount="<%= Number(order.orderAmount) %>" class="max-h-[90vh] overflow-y-auto rounded-3xl bg-white p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-2xl font-black text-slate-900">Thêm phụ kiện vào đơn hàng</h2>
          <p class="mt-1 text-sm text-slate-500">Tổng tiền mới phải lớn hơn tổng tiền đơn hiện tại.</p>
        </div>
        <button type="button" data-add-order-accessory-close aria-label="Đóng" class="inline-flex size-10 items-center justify-center rounded-full bg-slate-100 text-2xl leading-none text-slate-600 transition hover:bg-slate-200">&times;</button>
      </div>

      <div id="add-order-accessories-container" class="mt-6 space-y-4"></div>
      <button type="button" data-add-order-accessory-row class="mt-4 rounded-full bg-brand-50 px-4 py-2 text-sm font-semibold text-brand-700 transition hover:bg-brand-100">Thêm dòng phụ kiện</button>

      <datalist id="available-order-accessories">
        <% availableAccessories.forEach((accessory) => { %>
          <option value="<%= accessory.code %>" data-price="<%= accessory.price %>"><%= [accessory.code, accessory.name].filter(Boolean).join(" - ") %></option>
        <% }) %>
      </datalist>

      <label class="mt-4 block">
        <span class="mb-2 block text-sm font-semibold text-slate-700">Tổng tiền đơn mới</span>
        <input name="orderAmount" type="number" min="<%= Number(order.orderAmount) %>" step="1" data-add-order-accessory-total data-greater-than-current-message="Tổng tiền đơn mới không được nhỏ hơn tiền đơn hiện tại." required placeholder="Tự động tính sau khi chọn phụ kiện" class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
        <p class="mt-2 text-sm text-slate-500">Tổng tiền hiện tại: <%= formatCurrency(order.orderAmount) %></p>
      </label>

      <div class="mt-6 flex justify-end gap-3">
        <button type="button" data-add-order-accessory-close class="rounded-full bg-slate-100 px-5 py-3 font-semibold text-slate-700 transition hover:bg-slate-200">Hủy</button>
        <button type="submit" class="rounded-full bg-brand-500 px-5 py-3 font-semibold text-white transition hover:bg-brand-700">Thêm phụ kiện</button>
      </div>
    </form>
  </dialog>

  <template id="add-order-accessory-row-template">
    <div data-add-order-accessory-entry class="rounded-3xl border border-slate-200 bg-slate-50 p-4">
      <div class="flex items-center justify-between gap-3">
        <p class="font-semibold text-slate-700">Phụ kiện bổ sung</p>
        <button type="button" data-remove-order-accessory-row class="rounded-full bg-rose-50 px-3 py-1.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">Xóa</button>
      </div>
      <label class="mt-4 block">
        <span class="mb-2 block text-sm font-semibold text-slate-700">Phụ kiện</span>
        <input name="accessoryCodes" type="text" list="available-order-accessories" data-add-order-accessory-code required autocomplete="off" placeholder="Tìm kiếm hoặc chọn phụ kiện" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
      </label>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label>
          <span class="mb-2 block text-sm font-semibold text-slate-700">Giá phụ kiện</span>
          <input name="accessoryPrices" type="number" min="0" step="0.01" data-add-order-accessory-price required placeholder="Nhập giá phụ kiện" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
        </label>
        <label>
          <span class="mb-2 block text-sm font-semibold text-slate-700">Số lượng thuê</span>
          <input name="accessoryAmounts" type="number" min="1" step="1" value="1" data-add-order-accessory-amount required class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
        </label>
      </div>
    </div>
  </template>

  <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
    <h2 class="text-2xl font-black text-slate-900">Thanh toán và trạng thái</h2>
    <div class="mt-5 grid gap-6 md:grid-cols-2">
      <div class="space-y-4">
        <div class="rounded-3xl border border-brand-100 bg-brand-50/60 p-5">
          <h3 class="text-lg font-bold text-slate-900">Thanh toán</h3>
          <% if (order.payments.length === 0) { %>
            <p class="mt-4 text-sm text-slate-500">Chưa có thanh toán nào.</p>
          <% } else { %>
            <div class="mt-4 space-y-3">
              <% order.payments.forEach((payment, paymentIndex) => { %>
                <form action="/orders/<%= order._id %>/payments/<%= paymentIndex %>?_method=PUT" method="POST" class="rounded-3xl border border-brand-100 bg-white/80 p-4">
                  <div class="grid gap-3 sm:grid-cols-2">
                    <input name="amount" type="number" min="0" step="0.01" required value="<%= payment.amount %>" aria-label="Số tiền thanh toán" class="rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
                    <select name="type" required aria-label="Hình thức thanh toán" class="rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100">
                      <option value="0" <%= payment.type === 0 ? "selected" : "" %>>Chuyển khoản</option>
                      <option value="1" <%= payment.type === 1 ? "selected" : "" %>>Tiền mặt</option>
                    </select>
                  </div>
                  <button type="submit" class="mt-3 rounded-full bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-800 transition hover:bg-amber-200">Cập nhật thanh toán</button>
                </form>
              <% }) %>
            </div>
          <% } %>
        </div>

        <form action="/orders/<%= order._id %>/payments" method="POST" class="rounded-3xl border border-brand-100 bg-brand-50/60 p-5">
          <h3 class="text-lg font-bold text-slate-900">Thêm thanh toán mới</h3>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <input name="amount" type="number" min="0" step="0.01" required placeholder="Số tiền" class="rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
            <select name="type" required class="rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100">
              <option value="0" selected>Chuyển khoản</option>
              <option value="1">Tiền mặt</option>
            </select>
          </div>
          <button type="submit" class="mt-4 rounded-full bg-brand-500 px-5 py-3 font-semibold text-white transition hover:bg-brand-700">Thêm thanh toán</button>
        </form>
      </div>

      <div class="space-y-4">
        <div class="rounded-3xl bg-slate-50 p-5">
          <p class="text-slate-700">Trạng thái lấy đồ: <span class="font-semibold"><%= order.alreadyPickup ? "Đã lấy" : "Chờ lấy" %></span></p>
          <p class="mt-3 text-slate-700">Trạng thái trả đồ: <span class="font-semibold"><%= order.returned ? "Đã trả" : "Đang thuê" %></span></p>
          <p class="mt-3 text-slate-700">Đã hoàn cọc: <span class="font-semibold"><%= order.returnDeposit ? "Có" : "Không" %></span></p>
        </div>

        <form action="/orders/<%= order._id %>/status" method="POST" class="rounded-3xl border border-slate-200 p-5">
          <h3 class="text-lg font-bold text-slate-900">Cập nhật trạng thái</h3>
          <div class="mt-4 space-y-3">
            <label class="flex items-center gap-3 text-sm font-semibold text-slate-700">
              <input name="alreadyPickup" type="checkbox" <%= order.alreadyPickup ? "checked" : "" %> class="size-4 rounded border-slate-300 text-brand-500 focus:ring-brand-500" />
              Đã lấy đồ
            </label>
            <label class="flex items-center gap-3 text-sm font-semibold text-slate-700">
              <input name="returned" type="checkbox" <%= order.returned ? "checked" : "" %> class="size-4 rounded border-slate-300 text-brand-500 focus:ring-brand-500" />
              Đã trả đồ
            </label>
            <label class="flex items-center gap-3 text-sm font-semibold text-slate-700">
              <input name="returnDeposit" type="checkbox" <%= order.returnDeposit ? "checked" : "" %> class="size-4 rounded border-slate-300 text-brand-500 focus:ring-brand-500" />
              Đã hoàn cọc
            </label>
          </div>
          <button type="submit" class="mt-4 rounded-full bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-slate-700">Cập nhật trạng thái</button>
        </form>
      </div>
    </div>
  </div>
</section>
