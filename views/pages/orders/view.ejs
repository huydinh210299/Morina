<%
  const totalPaid = order.payments.reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
  const totalDue = Number(order.orderAmount || 0) + Number(order.surcharge || 0) + Number(order.deposit || 0);
  const remainingAmount = totalDue - totalPaid;
  const isOverpaid = remainingAmount < 0;
%>

<section class="space-y-6">
  <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand-700">Chi tiết đơn hàng</p>
        <h1 class="mt-3 text-3xl font-black text-slate-900"><%= order.customerName %> · <%= order.phone %></h1>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/orders/<%= order._id %>/edit" class="rounded-full bg-amber-100 px-5 py-3 font-semibold text-amber-800">Chỉnh sửa</a>
        <a href="/orders" class="rounded-full bg-slate-100 px-5 py-3 font-semibold text-slate-700">Quay lại</a>
      </div>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      <div class="rounded-3xl bg-slate-50 p-5">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Lịch thuê</p>
        <p class="mt-3 text-slate-700">Bắt đầu: <%= formatDateTime(order.generalStartTime) %></p>
        <p class="mt-2 text-slate-700">Kết thúc: <%= formatDateTime(order.generalEndTime) %></p>
      </div>
      <div class="rounded-3xl bg-slate-50 p-5">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Tài chính</p>
        <p class="mt-3 text-slate-700">Tổng tiền đơn: <%= formatCurrency(order.orderAmount) %></p>
        <p class="mt-2 text-slate-700">Phụ thu: <%= formatCurrency(order.surcharge) %></p>
        <p class="mt-2 text-slate-700">Tiền cọc: <%= formatCurrency(order.deposit) %></p>
        <p class="mt-2 text-slate-700">Đã thanh toán: <%= formatCurrency(totalPaid) %></p>
        <p class="mt-2 text-slate-700"><%= isOverpaid ? "Thanh toán dư" : "Còn cần thanh toán" %>: <span class="font-semibold <%= isOverpaid ? 'text-emerald-700' : 'text-rose-700' %>"><%= formatCurrency(Math.abs(remainingAmount)) %></span></p>
      </div>
      <div class="rounded-3xl bg-slate-50 p-5">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Trạng thái</p>
        <p class="mt-3 text-slate-700">Giao hàng: <%= order.bookship ? "Có" : "Không" %></p>
        <p class="mt-2 text-slate-700">Đã lấy đồ: <%= order.alreadyPickup ? "Đã lấy" : "Chờ lấy" %></p>
        <p class="mt-2 text-slate-700">Trả đồ: <%= order.returned ? "Đã trả" : "Đang thuê" %></p>
        <p class="mt-2 text-slate-700">Hoàn cọc: <%= order.returnDeposit ? "Đã hoàn" : "Chưa hoàn" %></p>
      </div>
    </div>

    <% if (order.note) { %>
      <div class="mt-6 rounded-3xl bg-slate-50 p-5">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-500">Ghi chú</p>
        <p class="mt-3 whitespace-pre-wrap text-slate-700"><%= order.note %></p>
      </div>
    <% } %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
      <h2 class="text-2xl font-black text-slate-900">Sản phẩm</h2>
      <div class="mt-5 space-y-4">
        <% if (order.products.length === 0) { %><p class="text-slate-500">Không có dữ liệu sản phẩm.</p><% } %>
        <% order.products.forEach((item) => { %>
          <div class="rounded-3xl border border-slate-200 p-4">
            <p class="font-semibold text-slate-900"><%= item.product?.code || "Sản phẩm không xác định" %></p>
            <p class="mt-2 text-sm text-slate-600">Giá thuê: <%= formatCurrency(item.price) %></p>
            <p class="mt-1 text-sm text-slate-500"><%= formatDateTime(item.startTime) %> → <%= formatDateTime(item.endTime) %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
      <h2 class="text-2xl font-black text-slate-900">Phụ kiện</h2>
      <div class="mt-5 space-y-4">
        <% if (order.accessories.length === 0) { %><p class="text-slate-500">Không có dữ liệu phụ kiện.</p><% } %>
        <% order.accessories.forEach((item) => { %>
          <div class="rounded-3xl border border-slate-200 p-4">
            <p class="font-semibold text-slate-900"><%= item.accessory?.code || "Phụ kiện không xác định" %><%= item.accessory?.name ? ` - ${item.accessory.name}` : "" %></p>
            <p class="mt-2 text-sm text-slate-600">Số lượng thuê: <%= item.amount ?? 1 %> · Giá thuê: <%= formatCurrency(item.price) %></p>
            <p class="mt-1 text-sm text-slate-500"><%= formatDateTime(item.startTime) %> → <%= formatDateTime(item.endTime) %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="rounded-[2rem] bg-white p-8 shadow-xl shadow-slate-200/60">
    <h2 class="text-2xl font-black text-slate-900">Thanh toán</h2>
    <% if (order.payments.length === 0) { %>
      <p class="mt-5 text-slate-500">Không có dữ liệu thanh toán.</p>
    <% } else { %>
      <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% order.payments.forEach((payment) => { %>
          <div class="rounded-3xl border border-slate-200 p-4">
            <p class="font-semibold text-slate-900"><%= formatCurrency(payment.amount) %></p>
            <p class="mt-2 text-sm text-slate-500"><%= Number(payment.type) === 1 ? "Tiền mặt" : "Chuyển khoản" %></p>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
